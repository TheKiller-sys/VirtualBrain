# Servidor
PORT=3000
NODE_ENV=production

# Base de datos
DATABASE_PATH=./database/cerebro.db
DB_BACKUP_INTERVAL=3600000

# Parámetros del cerebro
AUTO_SAVE_INTERVAL=100
CONSCIOUSNESS_UPDATE_INTERVAL=10
NEUROPLASTICITY_RATE=0.15
LEARNING_RATE=0.12

# Seguridad
JWT_SECRET=tu_secreto_super_seguro
API_KEY=tu_api_key_para_acceso

# Debug
DEBUG_MODE=false
LOG_LEVEL=info
